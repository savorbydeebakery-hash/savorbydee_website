{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "savor-bakery",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "savor-bakery-incremental-cache"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_TAG_CACHE_KV",
      "id": "placeholder-kv-id"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/1 * * * *"]
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "",
    "STAFF_NOTIFY_EMAIL": ""
  },
  "env": {
    "staging": {
      "name": "savor-bakery-staging",
      "vars": {
        "NEXT_PUBLIC_SUPABASE_URL": "",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "",
        "STAFF_NOTIFY_EMAIL": ""
      }
    },
    "production": {
      "name": "savor-bakery-production",
      "vars": {
        "NEXT_PUBLIC_SUPABASE_URL": "",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "",
        "STAFF_NOTIFY_EMAIL": ""
      }
    }
  }
}