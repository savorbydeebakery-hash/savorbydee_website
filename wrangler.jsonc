{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "savor-bakery",
  // Wraps .open-next/worker.js to add the cron handler it lacks.
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_TAG_CACHE_KV",
      "id": "f093d94fdebf4188aa60ded662505117"
    },
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "53cc6d539bcc4482a941b535d56f9eca"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Names saved pages per deploy (lib/site/page-cache.ts). Not inherited by the
  // environments below, so each repeats it.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Per visitor address, a minute at a time (lib/site/rate-limit.ts). Also not inherited.
  "ratelimits": [
    { "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "LOOKUP_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  // No cron by default. Set per environment below, on the live worker only:
  // both workers share one database, so a cron on each would send every
  // unacknowledged-order reminder twice.
  "triggers": {
    "crons": []
  },
  "env": {
    "staging": {
      // Despite the name, this is the worker serving savorbydee.in: every
      // normal deploy targets it (deploy.yml defaults to --env staging).
      "name": "savor-bakery-staging",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "ratelimits": [
        { "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
        { "name": "LOOKUP_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
      ],
      "triggers": {
        "crons": ["*/1 * * * *"]
      },
      "kv_namespaces": [
        {
          "binding": "NEXT_TAG_CACHE_KV",
          "id": "f093d94fdebf4188aa60ded662505117"
        },
        {
          "binding": "NEXT_INC_CACHE_KV",
          "id": "53cc6d539bcc4482a941b535d56f9eca"
        }
      ]
    },
    "production": {
      "name": "savor-bakery-production",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "ratelimits": [
        { "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
        { "name": "LOOKUP_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
      ],
      "triggers": {
        "crons": []
      },
      "kv_namespaces": [
        {
          "binding": "NEXT_TAG_CACHE_KV",
          "id": "f093d94fdebf4188aa60ded662505117"
        },
        {
          "binding": "NEXT_INC_CACHE_KV",
          "id": "53cc6d539bcc4482a941b535d56f9eca"
        }
      ]
    }
  }
}