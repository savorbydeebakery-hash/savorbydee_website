{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "savor-bakery",
  // Wraps .open-next/worker.js to add the cron handler it lacks.
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_TAG_CACHE_KV",
      "id": "f093d94fdebf4188aa60ded662505117"
    },
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "53cc6d539bcc4482a941b535d56f9eca"
    }
  ],
  "observability": {
    "enabled": true
  },
  // No cron by default. Set per environment below, on the live worker only:
  // both workers share one database, so a cron on each would send every
  // unacknowledged-order reminder twice.
  "triggers": {
    "crons": []
  },
  "env": {
    "staging": {
      // Despite the name, this is the worker serving savorbydee.in: every
      // normal deploy targets it (deploy.yml defaults to --env staging).
      "name": "savor-bakery-staging",
      "triggers": {
        "crons": ["*/1 * * * *"]
      },
      "kv_namespaces": [
        {
          "binding": "NEXT_TAG_CACHE_KV",
          "id": "f093d94fdebf4188aa60ded662505117"
        },
        {
          "binding": "NEXT_INC_CACHE_KV",
          "id": "53cc6d539bcc4482a941b535d56f9eca"
        }
      ]
    },
    "production": {
      "name": "savor-bakery-production",
      "triggers": {
        "crons": []
      },
      "kv_namespaces": [
        {
          "binding": "NEXT_TAG_CACHE_KV",
          "id": "f093d94fdebf4188aa60ded662505117"
        },
        {
          "binding": "NEXT_INC_CACHE_KV",
          "id": "53cc6d539bcc4482a941b535d56f9eca"
        }
      ]
    }
  }
}